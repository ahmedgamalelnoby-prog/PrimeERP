# PrimeERP production environment template
# Copy to your deployment environment and replace every placeholder with a real secret/value.

APP_ENV=production
APP_NAME=PrimeERP
APP_VERSION=1.0.0
DEBUG=false

POSTGRES_DB=primeerp
POSTGRES_USER=primeerp
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_DATABASE_PASSWORD

# PostgreSQL is assembled by docker-compose from the values above.
# For non-Docker deployments, set DATABASE_URL explicitly.
DATABASE_URL=postgresql+psycopg://primeerp:REPLACE_WITH_A_STRONG_DATABASE_PASSWORD@db:5432/primeerp

# Generate a cryptographically random secret of at least 32 characters.
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Explicit HTTPS origins only; do not use localhost in production.
CORS_ORIGINS=https://erp.example.com
